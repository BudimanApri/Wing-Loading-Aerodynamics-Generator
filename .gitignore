# Public source allowlist: unrecognized root files stay private by default.
/*
!/.gitignore
!/app.py
!/run.ps1
!/requirements.txt
!/requirements-lock.txt
!/pytest.ini
!/README.md
!/LICENSE
!/LICENSE.*
!/NOTICE
!/.gitattributes
!/.editorconfig
!/.github/
!/src/
!/tests/
!/.streamlit/
!/data/

# Source trees contain Python only; raw extensionless exports stay private.
/src/**
!/src/**/
!/src/**/*.py
/tests/**
!/tests/**/
!/tests/**/*.py

# Only empty data folder placeholders are public.
/data/*
!/data/raw/
!/data/processed/
!/data/results/
/data/raw/*
/data/processed/*
/data/results/*
!/data/raw/.gitkeep
!/data/processed/.gitkeep
!/data/results/.gitkeep

# Local notes and inspection helpers stay private.
/IMPLEMENTATION_STATUS.md
/tools/
.venv/
venv/
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.py[cod]
*.log
.vscode/
.idea/
.DS_Store
Thumbs.db

# Credential files; the root environment example must contain placeholders only.
.env
.env.*
!/.env.example
.streamlit/*
!/.streamlit/config.toml
*.pem
*.key
*.p12
*.pfx
*.jks
id_rsa*
id_ed25519*
.aws/
.azure/
.gcp/
.ssh/
.codex/
credentials*.json
*credentials*.json
*secret*.json
service-account*.json

# Data files remain private even if copied into a source directory.
*.csv
*.tsv
*.txt
!/requirements.txt
!/requirements-lock.txt
!/LICENSE.txt
*.json
*.asc
*.ascii
*.cas
*.dat
*.msh
*.h5
*.cgns
*.plt
*.npy
*.npz
*.parquet
*.xlsx
*.xls
*.vtk
*.vtp
*.vtu
